<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111F"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WINHDR  /  GAMING ENVIRONMENT"
                android:textColor="#55DDF5"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/winhdr_home_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="ARM64"
                android:textColor="#55DDF5"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Your games.\nYour rules."
            android:textColor="#F4F8FF"
            android:textSize="34sp"
            android:lineSpacingExtra="1dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="A focused control center for your Windows game containers on Android."
            android:textColor="#9FB2C9"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/winhdr_home_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START HERE"
                android:textColor="#55DDF5"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Your Windows workspace"
                android:textColor="#F4F8FF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Create or open a container to install and run compatible apps and games."
                android:textColor="#9FB2C9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnHomeContainers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#55DDF5"
                android:text="OPEN CONTAINERS   →"
                android:textColor="#07111D"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="QUICK ACCESS"
            android:textColor="#F4F8FF"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHomeGames"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#102237"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:text="🎮    GAME LIBRARY"
            android:textColor="#F4F8FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHomeControls"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#102237"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:text="⌨    CONTROLS &amp; MAPPING"
            android:textColor="#F4F8FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHomeSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#102237"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:text="⚙    PERFORMANCE &amp; SETTINGS"
            android:textColor="#F4F8FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="WINHDR  •  POWERED BY WINLATOR"
            android:textColor="#60758D"
            android:textSize="10sp"
            android:letterSpacing="0.08" />
    </LinearLayout>
</ScrollView>
