<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B15">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#08111F">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:id="@+id/Toolbar"
            android:background="#060D19"
            android:elevation="1dp"
            app:titleTextColor="#F4F8FF"
            app:layout_scrollFlags="enterAlways|scroll"
            app:title="@string/app_name" />

        <FrameLayout
            android:id="@+id/FLFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#08111F"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:id="@+id/NavigationView"
        android:fitsSystemWindows="true"
        android:background="#102237"
        app:headerLayout="@layout/main_menu_header"
        app:itemIconTint="#9CB3D1"
        app:itemTextColor="#B9C8DE"
        app:itemBackground="@drawable/winhdr_nav_item_background"
        app:menu="@menu/main_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>