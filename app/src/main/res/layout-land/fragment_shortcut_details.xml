<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B15"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIBRARY  /  GAME DETAILS"
            android:textColor="#68A9FF"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="top">

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:background="@drawable/winhdr_game_card"
                android:padding="12dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/IVShortcutIcon"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:padding="24dp"
                    android:background="#10233B"
                    android:scaleType="fitCenter"
                    android:contentDescription="Application icon" />

                <TextView
                    android:id="@+id/TVShortcutContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#8EA5C4"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/TVShortcutKind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#D5E4F7"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVShortcutName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F1F6FF"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/winhdr_game_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="WINDOWS SHORTCUT"
                    android:textColor="#8DBEFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVShortcutPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="#8EA5C4"
                    android:textSize="12sp"
                    android:breakStrategy="simple" />

                <Button
                    android:id="@+id/BTPlayShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#1C63B9"
                    android:text="▶  Play"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/BTOpenFolder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#14263D"
                    android:text="Open containing folder"
                    android:textAllCaps="false"
                    android:textColor="#DBE7F7" />

                <Button
                    android:id="@+id/BTBackLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#102137"
                    android:text="← Back to library"
                    android:textAllCaps="false"
                    android:textColor="#DDE8F8" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>