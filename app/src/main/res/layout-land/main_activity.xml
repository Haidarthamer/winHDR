<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B15"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/PermanentNavigationRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#050B15">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/NavigationView"
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:background="#060D19"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/main_menu_header_compact"
            app:menu="@menu/main_menu"
            app:itemIconTint="#9CB3D1"
            app:itemTextColor="#B9C8DE"
            app:itemBackground="@drawable/winhdr_nav_item_background"
            app:itemHorizontalPadding="10dp"
            app:itemIconPadding="8dp"
            app:itemIconSize="19dp"
            app:dividerInsetStart="12dp"
            app:dividerInsetEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#050B15">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#060D19"
                android:elevation="2dp"
                app:contentInsetStart="10dp"
                app:titleTextColor="#F1F6FF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/GlobalSearch"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:background="#0D192A"
                        app:iconifiedByDefault="false"
                        app:queryHint="Search games, files, or executables..." />

                    <ImageView
                        android:id="@+id/btnTopControls"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:padding="11dp"
                        android:background="@drawable/winhdr_nav_item_background"
                        android:src="@drawable/icon_input_controls"
                        android:tint="#B9C8DE"
                        android:contentDescription="Open controls" />

                    <ImageView
                        android:id="@+id/btnTopSettings"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="11dp"
                        android:background="@drawable/winhdr_nav_item_background"
                        android:src="@drawable/icon_settings"
                        android:tint="#B9C8DE"
                        android:contentDescription="Open settings" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>

            <FrameLayout
                android:id="@+id/FLFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#050B15" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>